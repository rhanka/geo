    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "s3dag-reconciler-sa",
        "namespace": "geo",
        "labels": {
          "app.kubernetes.io/managed-by": "s3-dag"
        }
      }
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "Role",
      "metadata": {
        "name": "s3dag-pv-reconciler",
        "namespace": "geo",
        "labels": {
          "app.kubernetes.io/managed-by": "s3-dag"
        }
      },
      "rules": [
        {
          "apiGroups": [
            "batch"
          ],
          "resources": [
            "jobs"
          ],
          "verbs": [
            "get",
            "list",
            "create"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "pods"
          ],
          "verbs": [
            "get",
            "list"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "resourcequotas"
          ],
          "verbs": [
            "get"
          ]
        },
        {
          "apiGroups": [
            "coordination.k8s.io"
          ],
          "resources": [
            "leases"
          ],
          "resourceNames": [
            "s3dag-pv-reconciler-lock"
          ],
          "verbs": [
            "get",
            "update"
          ]
        },
        {
          "apiGroups": [
            "coordination.k8s.io"
          ],
          "resources": [
            "leases"
          ],
          "verbs": [
            "create"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
        "name": "s3dag-pv-reconciler",
        "namespace": "geo",
        "labels": {
          "app.kubernetes.io/managed-by": "s3-dag"
        }
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "s3dag-reconciler-sa",
          "namespace": "geo"
        }
      ],
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "Role",
        "name": "s3dag-pv-reconciler"
      }
    },
    {
      "apiVersion": "batch/v1",
      "kind": "CronJob",
      "metadata": {
        "name": "s3dag-pv-reconciler",
        "namespace": "geo",
        "labels": {
          "app.kubernetes.io/managed-by": "s3-dag"
        }
      },
      "spec": {
        "schedule": "*/2 * * * *",
        "concurrencyPolicy": "Forbid",
        "successfulJobsHistoryLimit": 1,
        "failedJobsHistoryLimit": 3,
        "suspend": false,
        "jobTemplate": {
          "spec": {
            "backoffLimit": 0,
            "ttlSecondsAfterFinished": 600,
            "template": {
              "metadata": {
                "labels": {
                  "app.kubernetes.io/managed-by": "s3-dag"
                }
              },
              "spec": {
                "serviceAccountName": "s3dag-reconciler-sa",
                "restartPolicy": "Never",
                "imagePullSecrets": [
                  {
                    "name": "geo-registry-pull"
                  }
                ],
                "containers": [
                  {
                    "name": "reconciler",
                    "image": "ghcr.io/rhanka/geo-capture:REPLACE_WITH_DIGEST_AT_APPLY",
                    "command": [
                      "tsx",
                      "src/s3dag/reconcile-run.ts"
                    ],
                    "env": [
                      {
                        "name": "NODE_OPTIONS",
                        "value": "--dns-result-order=ipv4first"
                      },
                      {
                        "name": "AWS_MAX_ATTEMPTS",
                        "value": "10"
                      },
                      {
                        "name": "S3DAG_DAG_ID",
                        "value": "pv-canary"
                      },
                      {
                        "name": "S3DAG_LANE",
                        "value": "pv"
                      },
                      {
                        "name": "S3DAG_RUN_ID",
                        "value": "canary"
                      },
                      {
                        "name": "S3DAG_NAMESPACE",
                        "value": "geo"
                      },
                      {
                        "name": "S3DAG_BUCKET",
                        "value": "sentropic-geo-preprod"
                      },
                      {
                        "name": "S3DAG_PREFIX",
                        "value": "preprod-runs/canary"
                      },
                      {
                        "name": "S3DAG_QUOTA",
                        "value": "tenant-quota"
                      },
                      {
                        "name": "S3DAG_IMAGE",
                        "value": "ghcr.io/rhanka/geo-capture:REPLACE_WITH_DIGEST_AT_APPLY"
                      },
                      {
                        "name": "S3DAG_S3_SECRET",
                        "value": "geo-s3-credentials-preprod"
                      },
                      {
                        "name": "S3DAG_CRONJOB",
                        "value": "s3dag-pv-reconciler"
                      }
                    ],
                    "envFrom": [
                      {
                        "secretRef": {
                          "name": "geo-s3-credentials-preprod"
                        }
                      }
                    ],
                    "resources": {
                      "requests": {
                        "cpu": "10m",
                        "memory": "32Mi"
                      },
                      "limits": {
                        "cpu": "200m",
                        "memory": "192Mi"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
